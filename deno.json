{
  "imports": {
    "@netlify/edge-functions": "https://edge.netlify.com/v1/index.ts",
    "@std/assert": "jsr:@std/assert@^1.0.13"
  },
  "tasks": {
    "check": "deno check --allow-import netlify/edge-functions/webhook.ts src/",
