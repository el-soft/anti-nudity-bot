# ---------------------------------------------------------------------------
# nudity-detector-bot — environment template
#
#   cp .env.example .env      # for `netlify dev`; .env must stay gitignored
#
# In production these are set in Netlify:
#   Site configuration -> Environment variables
#   or:  netlify env:set KEY "value"
#
# Values are read at cold start. Redeploy after changing them.
#
# THIS BOT REMOVES ACCOUNTS FROM YOUR GROUP.
# Deploy with DRY_RUN=true first and read the log for a day. See README step 6.
# ---------------------------------------------------------------------------


# === Required ===============================================================

# Token from @BotFather. Secret — never commit a real one.
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Shared secret echoed by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header. Must be identical to the `secret_token` you pass to setWebhook.
# Without it every caller who finds the URL can post fake updates.
# Generate one with:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# THE WHITELIST. Comma-separated numeric chat IDs to police; updates from any
# other chat are logged and nothing else. Group IDs are negative and usually
# carry a -100 prefix. Leaving this empty polices nothing at all.
ALLOWED_CHAT_IDS=-1001234567890


# === The safety switch ======================================================

# true  = decide and log, call nothing that changes the chat (the default)
# false = actually remove accounts
DRY_RUN=true


# === Who is allowed in ======================================================
#
# The rule: somebody has to have let them in. Added by a member, approved by an
# admin, or arrived through an invite link. Walking in unaided is what gets
# removed — a removal is a ban plus an immediate unban, so the account is out of
# the group but a member can still add them deliberately later. No messages are
# ever deleted.

# true  = an invite-link join counts as invited (the default)
# false = only accounts added by a member or approved by an admin may stay,
#         which also removes anyone who used a link a member shared
ALLOW_INVITE_LINK_JOINS=true

# Joins that arrive only as an in-chat service message ("X joined the group")
# carry no invite-link information at all, so acting on them can remove invited
# people. Leave this false unless the group is small enough that no join ever
# arrives as a chat_member update.
REMOVE_UNDISCLOSED_JOINS=false

# ignore  = leave join requests to your admins (the default)
# decline = decline every join request automatically
JOIN_REQUEST_ACTION=ignore


# === Safety rails ===========================================================

# Never removed, whatever they do. Comma-separated user IDs.
EXEMPT_USER_IDS=

# Circuit breaker: at most this many removals per hour per running instance.
# A bug or a raid cannot empty the group.
MAX_REMOVALS_PER_HOUR=20


# === Optional ===============================================================

# debug | info | warn | error. `received`, `allowed` and `enforced` are info.
LOG_LEVEL=info
