# ---------------------------------------------------------------------------
# nudity-detector-bot — environment template
#
#   cp .env.example .env      # for `netlify dev`; .env must stay gitignored
#
# In production these are set in Netlify:
#   Site configuration -> Environment variables
#   or:  netlify env:set KEY "value"
#
# Values are read at cold start. Redeploy after changing them.
#
# THIS BOT BANS ACCOUNTS AND DELETES THEIR MESSAGE HISTORY.
# Deploy with DRY_RUN=true first. See README step 7.
# ---------------------------------------------------------------------------


# === Required ===============================================================

# Token from @BotFather. Secret — never commit a real one.
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Shared secret echoed by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header. Must be identical to the `secret_token` you pass to setWebhook.
# Generate one with:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# THE WHITELIST. Comma-separated numeric chat IDs to watch; updates from any
# other chat are acknowledged and dropped without downloading anything.
# Group/supergroup IDs are negative and usually carry a -100 prefix.
# Leaving this empty means the bot processes nothing at all.
ALLOWED_CHAT_IDS=-1001234567890,-1009876543210


# === START HERE =============================================================

# true = run every trigger and both tracks end to end, log every verdict, but
# send no replies, delete nothing, decline nobody and ban nobody.
#
# Deploy like this, wait a day or two, then grep the Netlify logs for
#   "event":"enforcement"   -> accounts that WOULD have been banned
#   "trigger":"join"        -> confirms join scanning is actually working
# Adjust PROFILE_NSFW_THRESHOLD, then set this to false.
DRY_RUN=true


# === Account scan -> DELETE MESSAGES AND BAN ================================
#
# Requires the bot to be a group ADMIN with "Ban users" and "Delete messages".
# Admin status is ALSO what makes Telegram deliver `chat_member` join updates
# at all — a non-admin bot gets no join signal.

# Master switch for the whole account track (profile photo + bio).
SCAN_PROFILE=true

# Check a profile the moment the account joins, before it can post.
SCAN_ON_JOIN=true

# In groups with join approval enabled, vet the account BEFORE admitting it.
# A violation is declined rather than banned — nothing to delete, no ban.
SCAN_JOIN_REQUESTS=true

# Auto-approve join requests that pass the scan. Off by default: a clean scan
# is not an endorsement, so humans keep the approval decision.
APPROVE_CLEAN_JOIN_REQUESTS=false

# Also delete the "X joined the group" service notice when banning a joiner,
# so the chat isn't left with a notice for an account that no longer exists.
DELETE_JOIN_NOTICE=true

# Ban threshold for profile photos. Deliberately stricter than
# NSFW_THRESHOLD — a ban is not a warning. Refused at startup if lower
# than NSFW_THRESHOLD.
#
# Note: Telegram serves avatars at low resolution, which is a harder input
# for the classifier than a full-size photo. Expect borderline scores here.
PROFILE_NSFW_THRESHOLD=0.9

# How many of the account's recent profile photos to examine. Raising it
# catches an account that pushed a clean photo on top of explicit ones, at a
# proportional cost in downloads and classifications.
PROFILE_SCAN_DEPTH=1

# Which findings actually escalate to a ban:
#   profile_nsfw  - explicit profile photo
#   harmful_link  - blocklisted domain in the bio
#   message_nsfw  - explicit image in a message (NOT default: a single bad
#                   photo can be a mistake or a forward; an explicit avatar
#                   is what the account IS)
# Set to `harmful_link` alone to log image findings without acting on them —
# links are a far more objective signal than a classifier score.
ENFORCEMENT_REASONS=profile_nsfw,harmful_link

# Bad domains found in a bio. Comma-separated; a parent-domain entry covers
# its subdomains. Empty = link enforcement is inert.
LINK_BLOCKLIST=

# Or fetch the domain list from a URL at cold start instead.
# LINK_BLOCKLIST_URL=https://example.com/blocklist.txt

# Blunt structural bio rules, both off by default.
# BIO_MAX_LINKS=3
# BIO_BLOCK_INVITES=false

# Optional: additionally check unknown domains against Google Safe Browsing.
# THIS SENDS DOMAINS FROM USER BIOS TO GOOGLE, unlike everything else here,
# which stays local. Off unless you set a key.
# SAFE_BROWSING_API_KEY=

# Delete the banned account's message history. This is the only route Telegram
# offers for "delete all their messages" — it is a parameter of the ban, so you
# cannot wipe history without banning.
REVOKE_MESSAGES=true

# this_chat | all_chats
# all_chats bans the account in every chat in ALLOWED_CHAT_IDS, including ones
# it never entered.
BAN_SCOPE=this_chat

# How long a "clean" account is trusted before being rescanned. Seconds.
# 86400 = 1 day. This is also the window in which an avatar swap goes
# unnoticed. Lower = safer but more API calls and classifications.
PROFILE_CACHE_TTL_SECONDS=86400

# Also scan other bot accounts. They have no meaningful bio and are added
# deliberately by admins, so this is off.
SCAN_BOTS=false

# The /scan command, which group admins can run in the chat:
#   /scan              sweep the accounts the bot has seen in this group
#   /scan  (as a reply) check the account you replied to
#   /scan <user_id>    check that account
#
# Admin-only, checked live on every use, and it obeys DRY_RUN, the exemptions,
# ENFORCEMENT_REASONS and MAX_BANS_PER_HOUR exactly like automatic enforcement.
#
# The command message is deleted from the group and the result is sent to the
# admin who ran it, privately — so no scores or account IDs are left in front of
# the people being moderated. Admins must have opened a chat with the bot and
# pressed Start; if they haven't, the bot answers in the group and says so.
#
# NOTE: a bare /scan cannot mean "everyone in this group". Telegram gives bots no
# way to list a group's members, so the bot records a user ID on every join, join
# request and post, and the sweep covers that list. The reply says so every time.
# Accounts that have since left are skipped and dropped, never banned.
SCAN_COMMAND=true

# A forwarded message has two subjects: the member who forwarded it, and the
# original author. When the ORIGIN account is flagged, what happens to the
# member who forwarded it?
#   delete         - delete the message, leave the forwarder alone (they may be
#                    forwarding spam in order to complain about it)
#   delete_and_ban - treat forwarding it as the forwarder's own violation
#   ignore         - scan the forwarder only
FORWARD_ORIGIN_ACTION=delete


# === Message images -> warning reply ========================================

# Flag a message image when the score of NSFW_CLASSES reaches this value.
NSFW_THRESHOLD=0.7

# Which nsfwjs classes count as explicit.
# Available: Drawing, Hentai, Neutral, Porn, Sexy
# Adding `Sexy` catches more but flags swimwear, gym and beach photos — and if
# `message_nsfw` is in ENFORCEMENT_REASONS, those become bans.
NSFW_CLASSES=Porn,Hentai

# What to do about a flagged message image:
#   warn | warn_and_delete | delete | log
MESSAGE_ACTION=warn

# Text of the reply, attached to the offending message.
WARNING_MESSAGE=⚠️ This image was flagged as adult content.

# Which media to scan. Remove entries to cut cost and false positives.
# photo | sticker | document | video_thumbnail
SCAN_MEDIA_TYPES=photo,sticker,document,video_thumbnail

# Skip files larger than this, without downloading them. Bytes.
# 5242880 = 5 MB. Telegram's own getFile ceiling is 20 MB.
MAX_FILE_BYTES=5242880


# === Safety rails ===========================================================

# Never scanned, never banned. Group admins and the owner are already exempt.
# Put your own user ID here.
EXEMPT_USER_IDS=

# Don't enforce against accounts that joined before this date. Set it when
# deploying into an existing group: every member is scanned the first time they
# post, so the first days after a deploy are the highest-risk window for false
# positives — exactly when you have the least calibration data.
# EXEMPT_JOINED_BEFORE=2026-09-04

# Per-chat circuit breaker. Past this many bans in an hour, violations are
# logged and alerted but NOT enforced. This is what turns "the bot emptied my
# group overnight" into "the bot banned ten people and started shouting".
# Use DRY_RUN=true to disable enforcement; 0 is refused as ambiguous.
MAX_BANS_PER_HOUR=10

# Chat that receives a notice for every enforcement, with reason and score.
# Strongly recommended: it is your record for reviewing and undoing bans, and
# it outlives Netlify's log retention.
# ADMIN_ALERT_CHAT_ID=

# Leave any chat the bot is added to that isn't in ALLOWED_CHAT_IDS. The
# whitelist already prevents processing; leaving also stops the bot from
# accumulating admin rights in groups you don't know about.
LEAVE_UNLISTED_CHATS=true


# === Model hosting ==========================================================

# Optional. Fetch model.json + weight shards from here instead of the bundle.
# Use this if the Edge Function bundle exceeds Netlify's size limit.
# MODEL_BASE_URL=https://your-cdn.example.com/nsfwjs/model/

# Optional. Location of the TensorFlow.js WASM binaries.
# TFJS_WASM_BASE_URL=https://your-cdn.example.com/tfjs-backend-wasm/


# === Logging ================================================================

# debug | info | warn | error
# `debug` adds per-class scores — the input for calibrating both thresholds.
# Never logs image content, message text or bio text.
LOG_LEVEL=info
